# Configurações do Banco de Dados
DB_URL=jdbc:postgresql://localhost:5432/exemplo
DB_USERNAME=exemplo
DB_PASSWORD=exemplo

# Configurações do Pool de Conexões (Hikari)
DB_POOL_MAX=20
DB_POOL_MIN=5

# Configurações de Log e JPA
# Para PRODUCÃO: Use 'validate' ou 'none' em vez de 'update'
JPA_DDL_AUTO=update
SHOW_SQL=true

# Configurações de Segurança e JWT
# Colque chave longa para Hmac, em Base64 ou texto longo.
JWT_SECRET_KEY=coloque-uma-chave-longa-e-secreta-com-pelo-menos-32-caracteres
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_WINDOW_MS=60000

# Configurações de CORS Frontend (separado por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Mercado Pago configs
MERCADOPAGO_ACCESS_TOKEN=coloque-seu-token-aqui
MERCADOPAGO_WEBHOOK_URL=http://localhost:8080/api/v1/payments/webhook
MERCADOPAGO_FRONTEND_SUCCESS_URL=http://localhost:4200/checkout/sucesso
MERCADOPAGO_FRONTEND_FAILURE_URL=http://localhost:4200/checkout/falha
MERCADOPAGO_FRONTEND_PENDING_URL=http://localhost:4200/checkout/pendente
MERCADOPAGO_USE_SANDBOX_CHECKOUT_URL=true